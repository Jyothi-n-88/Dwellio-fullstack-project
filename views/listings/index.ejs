<% layout("/layouts/boilerplate") %>

<% if(allListings.length === 0) { %>
<% if(isMyListings) { %>

    <div class="text-center mt-5">
      <i class="fa-solid fa-house-circle-exclamation fa-3x mb-3 text-muted"></i>
      <h4>You haven't created any listings yet.</h4>
      <p class="text-muted">
        Start hosting your place and earn with Dwellio.
      </p>

      <a href="/listings/new" class="btn btn-dark mt-3">
        Switch to Hosting
      </a>
    </div>

  <% } else { %>

    <div class="text-center mt-5">
      <h4>No listings found.</h4>
      <p class="text-muted">
        Try searching for a different location.
      </p>
    </div>

  <% } %>

<% } else { %>
<h3 class="mb-4 indexhead">All Listings</h3>
  <div class="row g-4">
    <% for (let listing of allListings) { %>
      <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 out">
  <div class="card listing-card position-relative">

    <% if(currentUser) { %>
  <div style="position:absolute; top:10px; right:10px; z-index:1000;">
    <% if(currentUser.wishlist && 
          currentUser.wishlist.some(id => 
            id.toString() === listing._id.toString()
          )) { %>

      <form action="/wishlist/<%= listing._id %>?_method=DELETE" method="POST">
        <button type="submit"
          style="background:white; border:none; border-radius:50%; padding:8px; box-shadow:0 2px 6px rgba(0,0,0,0.2);">
          <i class="fa-solid fa-heart text-danger"></i>
        </button>
      </form>

    <% } else { %>

      <form action="/wishlist/<%= listing._id %>" method="POST">
        <button type="submit"
          style="background:white; border:none; border-radius:50%; padding:8px; box-shadow:0 2px 6px rgba(0,0,0,0.2);">
          <i class="fa-regular fa-heart"></i>
        </button>
      </form>

    <% } %>
  </div>
<% } %>
    <!-- Clickable Image -->
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <img 
        src="<%= listing.image?.url || 'https://q-xx.bstatic.com/xdata/images/hotel/max500/672628389.jpg' %>" 
        class="card-img-top listing-img" 
        alt="listing image">
    </a>

    <!-- Card Body -->
    <div class="card-body">
      <a href="/listings/<%= listing._id %>" 
         class="text-decoration-none text-dark">

        <p class="card-text">
          <%= listing.title %>
        </p>

        <p class="listing-price">
          <span class="fw-bold">
            ₹ <%= listing.price?.toLocaleString("en-IN") || "N/A" %>
          </span> / night
        </p>

      </a>
    </div>

  </div>
</div>
    <% } %>
  </div>

  <!-- Map only shows if listings exist -->
  <div id="map" style="width:100%; height:500px;" class="mt-5"></div>

  <script>
    const mapData = {
      token: "<%= mapToken %>",
      listings: <%- JSON.stringify(listingsGeoJSON) %>
    };
  </script>
  <% script = `
<script src="/js/indexMap.js"></script>
` %>

<% } %>
<% layout("/layouts/boilerplate") %>

<h3 class="mb-4 indexhead">All Listings</h3>

<div class="row g-4">
  <% for (let listing of allListings) { %>
    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 out">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card listing-card">

          <!-- Image -->
          <img 
            src="<%= listing.image?.url || 'https://q-xx.bstatic.com/xdata/images/hotel/max500/672628389.jpg' %>" 
            class="card-img-top listing-img" 
            alt="listing image"
          >

          <div class="card-body">
            <p class="card-text">
              <%= listing.title %>
            </p>

            <!-- Price -->
            <p class="listing-price">
              <span class="fw-bold">
                ₹ <%= listing.price?.toLocaleString("en-IN") || "N/A" %>
              </span> / night
            </p>
          </div>

        </div>
      </a>
    </div>
  <% } %>
</div>

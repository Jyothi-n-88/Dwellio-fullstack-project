<% layout("/layouts/boilerplate") %>

<div class="container mt-5 " style="max-width: 1100px;">
  <div class="row">

    <!-- LEFT SIDE -->
    <div class="col-lg-7">

      <div class="card shadow-sm p-4 rounded-4">

        <!-- Image -->
        <img 
          src="<%= listing.image?.url || 'https://q-xx.bstatic.com/xdata/images/hotel/max500/672628389.jpg' %>"
          class="img-fluid rounded mb-4"
          style="height: 400px; object-fit: cover;"
        />

        <p class="text-muted">
          Owned by <%= listing.owner.username %>
        </p>

        <h4><%= listing.title %></h4>

        <p class="text-muted">
          <%= listing.description %>
        </p>

        <h6 class="fw-bold">
          ₹ <%= listing.price.toLocaleString("en-IN") %> / night
        </h6>

        <p class="text-secondary">
          <i class="fa-solid fa-location-dot"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>

      </div>

    </div>
    <!-- RIGHT SIDE - RESERVE CARD -->
    <div class="col-lg-4 ">

      <div class="reserve-card shadow-lg p-4 rounded-4 w-100" style="max-width: 320px;">

        <h4 class="fw-bold">
          ₹<%= listing.price.toLocaleString("en-IN") %>
          <span class="text-muted fs-6">/ night</span>
        </h4>

        <p class="text-success small mb-3">
          Prices include all fees
        </p>

        <form action="/reservations/<%= listing._id %>" method="POST">

          <div class="booking-box mb-3">
            <div class="row g-0">
              <div class="col-6 border-end p-2">
                <label class="small fw-bold">CHECK-IN</label>
                <input type="date" name="checkIn" class="form-control border-0 p-0" required>
              </div>
              <div class="col-6 p-2">
                <label class="small fw-bold">CHECKOUT</label>
                <input type="date" name="checkOut" class="form-control border-0 p-0" required>
              </div>
            </div>
          </div>

          <button class="btn reserve-btn w-100 py-2 rounded-pill">
            Reserve
          </button>

        </form>

        <p class="text-muted text-center small mt-3">
          Free cancellation before <strong>18 March</strong>
        </p>

      </div>

    </div>

  </div>
</div>
<hr>
<!-- Reviews Section -->
<div class="container mt-5" style="max-width: 900px;">
  <div class="row justify-content-center">
    <div class="col-md-10">

      <!-- Heading -->
      <h4 class="mb-3">Reviews</h4>

      <% if (listing.reviews.length === 0) { %>
        <p class="text-muted">No reviews yet. Be the first to review!</p>
      <% } 
      else { %>
        <div class="row">
          <% listing.reviews.forEach(review => { %>
           <div class="col-md-6 col-lg-4 mb-4">
  <div class="card shadow-sm h-100 border">
    <div class="card-body">

      <!-- Username -->
      <h6 class="mb-2">
        @<%= review.author.username %>
      </h6>

      <!-- Stars -->
      <div class="starability-result mb-2"
           data-rating="<%= review.rating %>">
        Rated: <%= review.rating %> stars
      </div>

      <!-- Comment -->
      <p class="mb-2">
        "<%= review.comment %>"
      </p>

      <!-- Date -->
      <small class="text-muted d-block mb-2">
        <%= review.createdAt.toDateString() %>
      </small>

      <% if(currentUser && review.author.equals(currentUser._id)) { %>
        <form method="POST"
          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
          <button class="btn btn-sm btn-outline-danger">
            Delete
          </button>
        </form>
      <% } %>

    </div>
  </div>
</div>


          <% }) %>
        </div>

      <% } %>

    </div>
  </div>
</div>

<hr>
<!-- Add Review -->
<div class="container mt-4 mb-5" style="max-width: 700px;">
  <h4 class="mb-3">Leave a Review</h4>

  <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>

    <!-- Rating Slider -->
    <div class="mb-2">
      <h5>Ratings</h5>
      <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
    </div>

    <!-- Comment -->
    <div class="mb-3">
      <label class="form-label">Comment</label>
      <textarea
        name="review[comment]"
        class="form-control"
        rows="3"
        required
      ></textarea>
      <div class="invalid-feedback">
        Please write a review.
      </div>
    </div>

    <button class="btn btn-success">Submit Review</button>
  </form>
</div>
<hr>

<!-- Map Section -->
<div class="container mt-5 mb-5" style="max-width: 900px;">
  <h4 class="mb-3">Where you'll be</h4>
  <div id="map" style="height: 450px; width: 100%; border-radius: 12px;"></div>
</div>

<% if (listing.geometry && listing.geometry.coordinates) { %>

<script>
  const mapData = {
  token: "<%= mapToken %>",
  coordinates: <%- JSON.stringify(listing.geometry.coordinates) %>,
  title: "<%= listing.title %>",
  location: "<%= listing.location %>"
};
</script>

<% script = `
<script src="/js/map.js"></script>
` %>

<% } %>



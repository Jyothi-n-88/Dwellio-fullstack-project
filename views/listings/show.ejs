<% layout("/layouts/boilerplate") %>

<div class="container d-flex justify-content-center mt-5">
  <div class="card shadow-lg p-4 text-center" style="max-width: 700px; width: 100%;">

    <!-- Listing Image -->
    <img 
      src="<%= listing.image?.url || 'https://q-xx.bstatic.com/xdata/images/hotel/max500/672628389.jpg' %>"
      alt="Listing Image"
      class="img-fluid rounded mb-4"
      style="height: 350px; object-fit: cover;"
    />

    <!-- Listing Info -->
    <h3 class="mb-2"><%= listing.title %></h3>
    <p class="text-muted"><%= listing.description %></p>

    <h5 class="fw-bold">
      &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
 / night
    </h5>

    <p class="mt-2">
      <i class="fa-solid fa-location-dot"></i>
      <%= listing.location %>, <%= listing.country %>
    </p>

    <!-- Buttons -->
    <div class="d-flex justify-content-center gap-3 mt-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">
        Edit
      </a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-danger">
          Delete
        </button>
      </form>
    </div>

  </div>
</div>
<!-- Reviews Section -->
<div class="container mt-5" style="max-width: 700px;">
  <h4 class="mb-3">Reviews</h4>

  <% if (listing.reviews.length === 0) { %>
    <p class="text-muted">No reviews yet. Be the first to review!</p>
  <% } else { %>
    <% listing.reviews.forEach(review => { %>
      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <h6 class="fw-bold mb-1">
            Rating: ⭐ <%= review.rating %> / 5
          </h6>
          <p class="mb-1"><%= review.comment %></p>
          <small class="text-muted">
            <%= review.createdAt.toDateString() %>
          </small>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<hr>
<!-- Add Review -->
<div class="container mt-4 mb-5" style="max-width: 700px;">
  <h5 class="mb-3">Leave a Review</h5>

  <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>

    <!-- Rating Slider -->
    <div class="mb-3">
      <label class="form-label">
        Rating: <span id="ratingValue">3</span> ⭐
      </label>
      <input 
        type="range" 
        name="review[rating]"
        class="form-range"
        min="0"
        max="5"
        step="1"
        value="3"
        oninput="ratingValue.innerText = this.value"
        required
      >
    </div>

    <!-- Comment -->
    <div class="mb-3">
      <label class="form-label">Comment</label>
      <textarea
        name="review[comment]"
        class="form-control"
        rows="3"
        required
      ></textarea>
      <div class="invalid-feedback">
        Please write a review.
      </div>
    </div>

    <button class="btn btn-success">Submit Review</button>
  </form>
</div>


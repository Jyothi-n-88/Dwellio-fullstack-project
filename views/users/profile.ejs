<% layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      
      <div class="card shadow-sm p-4 mb-5 border-0 rounded-4 bg-white">
        <div class="d-flex align-items-center mb-4">
          <div class="me-4 text-center position-relative">
            <form id="avatarForm" action="/profile/image?_method=PUT" method="POST" enctype="multipart/form-data">
              <label for="avatarInput" class="avatar-wrapper cursor-pointer">
                <% if(user.image && user.image.url) { %>
                  <img src="<%= user.image.url %>" class="rounded-circle shadow-sm" width="120" height="120" style="object-fit: cover; border: 4px solid #fff;">
                <% } else { %>
                  <div class="avatar-default d-flex justify-content-center align-items-center rounded-circle bg-light border" style="width: 120px; height: 120px;">
                    <i class="fa-solid fa-user fa-3x text-secondary"></i>
                  </div>
                <% } %>
                <div class="camera-icon bg-danger text-white rounded-circle p-2 position-absolute bottom-0 end-0">
                  <i class="fa-solid fa-camera fa-xs"></i>
                </div>
              </label>
              <input type="file" name="profileImage" id="avatarInput" class="d-none" onchange="document.getElementById('avatarForm').submit()">
            </form>
          </div>
          <div>
            <h3 class="fw-bold mb-0 text-dark"><%= user.username %></h3>
            <p class="text-muted mb-2"><%= user.email %></p>
            <span class="badge bg-light text-dark border p-2">
              <i class="fa-solid fa-calendar-days me-1"></i> Member Since: <%= user.createdAt ? user.createdAt.getFullYear() : "2024" %>
            </span>
          </div>
        </div>
        
        <div class="d-flex gap-2">
            <a href="/listings/new" class="btn btn-danger rounded-pill px-4">Create New Listing</a>
            <% if(user.image && user.image.url) { %>
                <form action="/profile/image?_method=DELETE" method="POST">
                    <button class="btn btn-outline-secondary rounded-pill">Remove Photo</button>
                </form>
            <% } %>
        </div>
      </div>

      <h2 class="mb-4 fw-bold"><i class="fa-solid fa- suitcase me-2 text-danger"></i>My Reservations</h2>

      <% if (reservations.length === 0) { %>
        <div class="text-center p-5 bg-white rounded-4 border border-dashed">
            <i class="fa-solid fa-calendar-xmark fa-3x text-muted mb-3"></i>
            <p class="text-muted">No reservations yet. Start exploring amazing stays!</p>
            <a href="/listings" class="btn btn-outline-danger rounded-pill">Explore Listings</a>
        </div>
      <% } else { %>
        <div class="row">
          <% reservations.forEach(reservation => { %>
            <div class="col-12 mb-4">
              <div class="card p-3 shadow-sm border-0 rounded-4 hover-shadow" style="transition: 0.3s;">
                <div class="row align-items-center">
                  
                  <div class="col-md-3">
                    <img src="<%= reservation.listing.image?.url %>" class="img-fluid rounded-3" style="height: 140px; width: 100%; object-fit: cover;">
                  </div>

                  <div class="col-md-6 mt-3 mt-md-0">
                    <h5 class="fw-bold mb-1"><%= reservation.listing.title %></h5>
                    <p class="text-muted small mb-3">📍 <%= reservation.listing.location %></p>
                    
                    <div class="d-flex flex-wrap gap-4 mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-bed text-danger me-2"></i>
                            <div>
                                <small class="text-muted d-block">Rooms Reserved</small>
                                <span class="fw-bold"><%= reservation.roomsBooked %> Room<%= reservation.roomsBooked > 1 ? 's' : '' %></span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-clock text-primary me-2"></i>
                            <div>
                                <small class="text-muted d-block">Duration</small>
                                <span class="small"><%= reservation.checkIn.toLocaleDateString('en-IN', { day:'numeric', month:'short' }) %> - <%= reservation.checkOut.toLocaleDateString('en-IN', { day:'numeric', month:'short' }) %></span>
                            </div>
                        </div>
                    </div>
                    
                    <h6 class="text-dark fw-bold mb-0">Total Paid: <span class="text-success">₹<%= reservation.totalPrice.toLocaleString("en-IN") %></span></h6>
                  </div>

                  <div class="col-md-3 text-md-end text-center mt-3 mt-md-0">
                    <form action="/reservations/<%= reservation._id %>?_method=DELETE" method="POST">
                      <button class="btn btn-outline-danger rounded-pill px-4 py-2 w-100 w-md-auto">
                        Cancel Reservation
                      </button>
                    </form>
                  </div>

                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

    </div>
  </div>
</div>

<style>
  .hover-shadow:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.1) !important;
    transform: translateY(-2px);
  }
  .avatar-wrapper {
    display: inline-block;
    position: relative;
    cursor: pointer;
  }
  .camera-icon {
    border: 2px solid #fff;
    cursor: pointer;
  }
  .border-dashed {
    border: 2px dashed #dee2e6 !important;
  }
</style>